# Copy to .env and fill in. Only the API key is required.
ANTHROPIC_API_KEY=

# Optional overrides, defaults shown.
# PORT=4000
# DATABASE_FILE=data/knowledge-inbox.db
# ANSWER_MODEL=claude-opus-5
# ANSWER_MAX_TOKENS=1024
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# CHUNK_MAX_CHARS=900
# CHUNK_OVERLAP_CHARS=150
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.15

# Deployment only. Origins allowed to call this API from a browser, comma separated.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com
# Put these on a persistent disk so data and the model survive a restart.
# DATABASE_FILE=/var/data/knowledge-inbox.db
# EMBEDDING_CACHE_DIR=/var/data/models
# Fill an empty library with a few sample notes on startup. Useful on a host with
# no persistent disk. Does nothing once anything has been saved.
# SEED_SAMPLE_DATA=true
